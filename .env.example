# Copy to .env and fill in. Django loads .env automatically; real environment variables override it.
DJANGO_DEBUG=1
# Production requires DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS.
# Teammate integration: dotted path to a Python callable.
RELAY_ANSWER_BACKEND=rag.services.answer_question
# RAG engine (see docs/RAG_ENGINE.md). Never commit a real key.
ANTHROPIC_API_KEY=
RELAY_LLM_MODEL=claude-haiku-5-5
RELAY_LLM_EFFORT=low
RELAY_REWRITE_MODEL=claude-haiku-5-5
RELAY_QUERY_REWRITE=1
# Vector search embeddings via OpenRouter.
OPENROUTER_API_KEY=
RELAY_EMBEDDING_MODEL=openai/text-embedding-3-small
RELAY_MIN_SIMILARITY=0.3
